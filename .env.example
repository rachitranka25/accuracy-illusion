# Nifty Oracle — credentials template. COPY this to `.env` and fill in your values.
# This file (.env.example) is safe to commit; the real .env is gitignored.

# ---- Angel One SmartAPI (primary live feed) ----
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
