GEMINI_API_KEY=

# ---- Upstox (optional) ----
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=

# ---- NVIDIA (AI analyst LLM backend) ----
NVIDIA_API_KEY=
